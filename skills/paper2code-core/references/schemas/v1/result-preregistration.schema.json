{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/result-preregistration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metrics", "target_points", "tolerances", "repeat_policy", "aggregation", "approved_before_target_results"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target_points": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "tolerances": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "repeat_policy": {"type": "object", "required": ["seeds"], "properties": {"seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}}}, "additionalProperties": true},
    "aggregation": {"type": "object"},
    "digitization_records": {"type": "array", "items": {"type": "string"}},
    "approved_before_target_results": {"const": true}
  }
}
