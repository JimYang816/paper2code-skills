{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/dataset-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source", "license", "availability", "preparation_recipe", "expected_files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "source": {"type": "object", "required": ["name", "url"], "properties": {"name": {"type": "string"}, "url": {"type": "string"}}, "additionalProperties": true},
    "license": {"type": "object", "required": ["name", "redistribution"], "properties": {"name": {"type": "string"}, "redistribution": {"type": "string"}}, "additionalProperties": true},
    "availability": {"enum": ["available", "unavailable", "restricted", "fixture"]},
    "preparation_recipe": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
  }
}
