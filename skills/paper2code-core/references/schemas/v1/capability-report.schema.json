{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/capability-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "available", "missing", "recovery_commands"],
  "properties": {
    "schema_version": {"const": "1.0"}, "stage": {"type": "string"},
    "available": {"type": "array", "items": {"type": "object"}}, "missing": {"type": "array", "items": {"type": "object"}},
    "recovery_commands": {"type": "array", "items": {"type": "string"}}
  }
}
