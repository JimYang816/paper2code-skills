{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/gate-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_scope", "artifact_hashes", "schema_versions", "approved_by", "approved_at", "authorizes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_scope": {"type": "string", "minLength": 1},
    "artifact_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "schema_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "authorizes": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}
  }
}
