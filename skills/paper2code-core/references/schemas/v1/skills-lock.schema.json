{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/skills-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_roots", "profiles"],
      "properties": {
        "core_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "profiles": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}
      }
    },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "content_hash", "modification", "dependencies"],
        "properties": {
          "origin": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "modification": {"enum": ["upstream_unchanged", "adapted", "new"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
