{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/evaluation-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "full_run_id",
    "evaluated_at",
    "contract_sha256",
    "full_run_report_sha256",
    "outcome",
    "claims",
    "failure"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "evaluation"},
    "status": {"enum": ["passed", "failed"]},
    "full_run_id": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_run_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["replicated", "partially replicated", "not replicated", "inconclusive"]},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "scope", "implementation", "execution", "result_agreement", "evidence", "verdict"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLM-[0-9]{4}$"},
          "title": {"type": "string", "minLength": 1},
          "scope": {"enum": ["must", "should", "out"]},
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "validation_ids", "message"],
            "properties": {
              "status": {"enum": ["passed", "failed", "inconclusive"]},
              "validation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "message": {"type": "string"}
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "command_ids", "seeds", "message"],
            "properties": {
              "status": {"enum": ["passed", "failed", "inconclusive"]},
              "command_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
              "message": {"type": "string"}
            }
          },
          "result_agreement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "metric_id", "observed", "target", "tolerance", "message"],
            "properties": {
              "status": {"enum": ["passed", "failed", "inconclusive"]},
              "metric_id": {"type": "string", "minLength": 1},
              "observed": {"type": ["number", "null"]},
              "target": {"type": "number"},
              "tolerance": {"type": "number", "minimum": 0},
              "message": {"type": "string"}
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strength", "minimum_strength", "sufficient", "seed_count", "message"],
            "properties": {
              "strength": {"enum": ["low", "moderate", "high"]},
              "minimum_strength": {"enum": ["low", "moderate", "high"]},
              "sufficient": {"type": "boolean"},
              "seed_count": {"type": "integer", "minimum": 0},
              "message": {"type": "string"}
            }
          },
          "verdict": {"enum": ["replicated", "not replicated", "inconclusive"]}
        }
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["class", "id", "message", "state", "return_target"],
      "properties": {
        "class": {"enum": ["software", "scientific", "result", "evidence", "environment"]},
        "id": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "state": {"enum": ["diagnosing", "needs_decision", "revision_required"]},
        "return_target": {"type": "string", "minLength": 1}
      }
    }
  }
}
