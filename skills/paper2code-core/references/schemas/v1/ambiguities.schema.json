{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/ambiguities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ambiguities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ambiguities": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["ambiguity_id", "scope", "question", "evidence_ids", "resolution"], "properties": {
      "ambiguity_id": {"type": "string", "pattern": "^A-[A-Z0-9-]+$"}, "scope": {"enum": ["must", "should", "out"]},
      "question": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}},
      "resolution": {"enum": ["open", "confirmed", "derived", "reconstructed", "empirically_selected", "excluded"]},
      "decision_record": {"type": ["string", "null"]}
    }}}
  }
}
