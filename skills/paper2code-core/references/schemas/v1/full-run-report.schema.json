{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/full-run-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "execution_mode",
    "run_id",
    "started_at",
    "completed_at",
    "bundle_sha256",
    "approval_sha256",
    "code_revision",
    "commands",
    "artifacts",
    "failure"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "full_run"},
    "status": {"enum": ["passed", "failed"]},
    "execution_mode": {"enum": ["local", "imported"]},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "seed", "status", "command", "log", "metrics", "outputs", "exit_code", "message"],
        "properties": {
          "id": {"type": "string", "pattern": "^CMD-[0-9]{4}$"},
          "seed": {"type": "integer", "minimum": 0},
          "status": {"enum": ["passed", "failed"]},
          "command": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "log": {"type": "string", "minLength": 1},
          "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "exit_code": {"type": ["integer", "null"]},
          "message": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "patternProperties": {"^.+$": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "additionalProperties": false
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["class", "id", "message", "state", "return_target"],
      "properties": {
        "class": {"enum": ["software", "scientific", "evidence", "environment"]},
        "id": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "state": {"enum": ["diagnosing", "needs_decision"]},
        "return_target": {"const": "full_run_approved"}
      }
    }
  }
}
