{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "run_id",
    "status",
    "resolved_config",
    "code_revision",
    "environment",
    "datasets",
    "seeds",
    "commands"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "full_run"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "status": {"enum": ["prepared", "approved"]},
    "resolved_config": {"type": "object"},
    "code_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": {"type": "string", "pattern": "^(HEAD|[0-9a-f]{7,64})$"},
        "dirty": {"const": false}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "platform", "dependencies", "capabilities"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "executable"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"const": "executable"},
              "executable": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "source", "license", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^DATA-[0-9]{4}$"},
          "path": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "command", "log", "metrics", "outputs", "failure_class"],
        "properties": {
          "id": {"type": "string", "pattern": "^CMD-[0-9]{4}$"},
          "title": {"type": "string", "minLength": 1},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "log": {"type": "string", "minLength": 1},
          "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "failure_class": {"enum": ["software", "scientific", "evidence", "environment"]}
        }
      }
    }
  }
}
