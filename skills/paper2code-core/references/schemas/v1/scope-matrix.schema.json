{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/scope-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "class",
          "scope",
          "evidence_ids",
          "ambiguity_ids",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CLM-[0-9]{4}$"
          },
          "title": {"type": "string", "minLength": 1},
          "class": {
            "enum": [
              "method",
              "baseline",
              "dataset",
              "experiment",
              "figure",
              "result_claim",
              "ablation"
            ]
          },
          "scope": {
            "enum": ["must", "should", "out"]
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "ambiguity_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
