{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "full_run_id",
    "preregistered_at",
    "preregistered_by",
    "claims",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "evaluation"},
    "status": {"const": "preregistered"},
    "full_run_id": {"type": "string", "minLength": 1},
    "preregistered_at": {"type": "string", "minLength": 1},
    "preregistered_by": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "scope", "implementation", "execution", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLM-[0-9]{4}$"},
          "title": {"type": "string", "minLength": 1},
          "scope": {"enum": ["must", "should", "out"]},
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["validation_ids"],
            "properties": {
              "validation_ids": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_ids", "independent_seeds"],
            "properties": {
              "command_ids": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^CMD-[0-9]{4}$"}
              },
              "independent_seeds": {"type": "boolean"},
              "minimum_successful_seeds": {"type": "integer", "minimum": 1},
              "seeds": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 0}
              }
            }
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric_id"],
            "properties": {
              "metric_id": {"type": "string", "pattern": "^MET-[0-9]{4}$"}
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provenance", "minimum_strength", "required_artifacts", "digitization_uncertainty"],
            "properties": {
              "provenance": {
                "enum": ["paper", "source-faithful", "reconstructed", "derived", "empirical", "excluded"]
              },
              "minimum_strength": {"enum": ["low", "moderate", "high"]},
              "required_artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              },
              "digitization_uncertainty": {"type": "number", "minimum": 0},
              "digitization_record": {"type": ["string", "null"]},
              "digitization_record_sha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "independent_cross_check": {"type": "boolean"}
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "path", "json_pointer", "aggregation", "target", "tolerance", "comparison"],
        "properties": {
          "id": {"type": "string", "pattern": "^MET-[0-9]{4}$"},
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "json_pointer": {"type": "string", "minLength": 1},
          "aggregation": {"enum": ["mean", "median", "min", "max", "first", "single"]},
          "target": {"type": "number"},
          "tolerance": {"type": "number", "minimum": 0},
          "comparison": {"enum": ["within", "equal", "lte", "gte"]},
          "max_standard_deviation": {"type": ["number", "null"], "minimum": 0}
        }
      }
    }
  }
}
