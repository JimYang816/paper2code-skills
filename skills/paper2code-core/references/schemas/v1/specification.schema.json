{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/specification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "method",
    "data",
    "baselines",
    "experiments",
    "figures",
    "metrics",
    "uncertainty",
    "budget",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "class",
              "scope",
              "evidence_ids",
              "ambiguity_ids",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CLM-[0-9]{4}$"
              },
              "title": {"type": "string", "minLength": 1},
              "class": {
                "enum": [
                  "method",
                  "baseline",
                  "dataset",
                  "experiment",
                  "figure",
                  "result_claim",
                  "ablation"
                ]
              },
              "scope": {
                "enum": ["must", "should", "out"]
              },
              "evidence_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "ambiguity_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "method": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/defs/item"}
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/defs/item"}
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/defs/item"}
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/defs/item"}
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/defs/item"}
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/defs/item"}
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digitization", "statistical"],
      "properties": {
        "digitization": {"type": "string", "minLength": 1},
        "statistical": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute", "seeds", "notes"],
      "properties": {
        "compute": {"type": "string", "minLength": 1},
        "seeds": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "claim_ids",
              "metric_id",
              "criterion",
              "tolerance",
              "scope"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ACC-[0-9]{4}$"
              },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "metric_id": {"type": "string", "minLength": 1},
              "criterion": {"type": "string", "minLength": 1},
              "tolerance": {"type": "string", "minLength": 1},
              "scope": {
                "enum": ["must", "should", "out"]
              }
            }
          }
        }
      }
    }
  },
  "defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "scope",
        "specification",
        "evidence_ids",
        "decision_ids",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,5}-[0-9]{4}$"
        },
        "title": {"type": "string", "minLength": 1},
        "scope": {
          "enum": ["must", "should", "out"]
        },
        "specification": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "decision_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "acceptance": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "higher_is_better": {"type": ["boolean", "null"]}
      }
    }
  }
}
