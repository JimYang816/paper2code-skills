{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "text",
          "provenance",
          "confidence",
          "status",
          "locator",
          "units",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVID-[0-9]{4}$"
          },
          "class": {
            "enum": [
              "formula",
              "parameter",
              "dataset",
              "network_component",
              "baseline",
              "result_claim"
            ]
          },
          "text": {"type": "string", "minLength": 1},
          "provenance": {
            "enum": [
              "paper_evidence",
              "supporting_source",
              "derived",
              "reconstructed",
              "empirically_selected"
            ]
          },
          "confidence": {
            "enum": ["confirmed", "high", "medium", "low"]
          },
          "status": {
            "enum": ["open", "triaged"]
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "text"],
            "properties": {
              "page": {"type": "integer", "minimum": 1},
              "text": {"type": "string", "minLength": 1},
              "section": {"type": ["string", "null"]},
              "equation": {"type": ["integer", "null"]},
              "figure": {"type": ["integer", "null"]},
              "table": {"type": ["integer", "null"]},
              "bbox": {
                "type": ["array", "null"],
                "items": {"type": "number"},
                "minItems": 4,
                "maxItems": 4
              }
            }
          },
          "units": {"type": ["string", "null"]},
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
