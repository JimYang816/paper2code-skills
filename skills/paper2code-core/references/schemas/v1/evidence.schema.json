{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "items": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["evidence_id", "kind", "provenance", "locator", "faithful_text", "confidence", "status"], "properties": {
      "evidence_id": {"type": "string", "pattern": "^E-[A-Z0-9-]+$"},
      "kind": {"enum": ["formula", "parameter", "dataset", "network", "result", "baseline", "citation"]},
      "provenance": {"enum": ["paper", "supporting_source", "derivation", "user_choice", "empirical_choice"]},
      "locator": {"type": "object", "required": ["page"], "properties": {"page": {"type": "integer", "minimum": 1}, "equation": {"type": ["string", "null"]}, "figure": {"type": ["string", "null"]}, "table": {"type": ["string", "null"]}}, "additionalProperties": true},
      "faithful_text": {"type": "string"}, "units": {"type": ["string", "null"]},
      "confidence": {"enum": ["high", "medium", "low"]}, "dependencies": {"type": "array", "items": {"type": "string"}},
      "status": {"enum": ["captured", "contradicted", "ambiguous", "excluded"]}
    }}}
  }
}
