{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/evidence-gate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "transition",
    "approved_at",
    "approved_by",
    "artifacts",
    "must_ambiguities"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate": {"const": "evidence"},
    "transition": {
      "const": "evidence_extracted -> evidence_approved"
    },
    "approved_at": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dossier/paper.md",
        "dossier/evidence.yaml",
        "dossier/audit.yaml",
        "dossier/ambiguities.yaml",
        "dossier/scope-matrix.yaml"
      ],
      "properties": {
        "dossier/paper.md": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dossier/evidence.yaml": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dossier/audit.yaml": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dossier/ambiguities.yaml": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dossier/scope-matrix.yaml": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "must_ambiguities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "resolved"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "resolved": {"type": "integer", "minimum": 0}
      }
    }
  }
}
