{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2code.local/schemas/v1/digitization-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "evidence_id", "source_page", "source_crop", "calibration", "points", "method", "cross_check", "uncertainty"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_id": {"type": "string"}, "evidence_id": {"type": "string"},
    "source_page": {"type": "integer", "minimum": 1}, "source_crop": {"type": "string"},
    "calibration": {"type": "object", "required": ["x_axis", "y_axis"], "properties": {"x_axis": {"type": "object"}, "y_axis": {"type": "object"}}, "additionalProperties": true},
    "points": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}, "additionalProperties": true},
    "method": {"type": "string"}, "cross_check": {"type": "object"}, "uncertainty": {"type": "object"}
  }
}
